# HeritageAI environment template.
# Copy this file to ".env" for local overrides. Never commit ".env".
# Every value below is optional; the shown values are the defaults.

# App identity (appears in /api/v1/health and the API docs)
# APP_NAME=HeritageAI API
# SERVICE_NAME=heritageai-api
# APP_VERSION=1.0.0

# Environment: development | test | production
# APP_ENV=development

# Comma-separated origins allowed to call the API from a browser
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local LLM (Ollama) used by the chat and itinerary modules
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3.2
# Ollama generation can take several minutes on CPU-backed models.
# OLLAMA_TIMEOUT_SECONDS=600

# Data locations (relative paths are resolved from the project root)
# DATA_DIR=data
# VECTOR_STORE_DIR=data/vector_store